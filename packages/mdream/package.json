{
  "name": "mdream",
  "type": "module",
  "version": "2.0.1",
  "description": "Ultra-performant HTML to Markdown Convertor Optimized for LLMs and llm.txt artifacts.",
  "author": {
    "name": "Harlan Wilton",
    "email": "harlan@harlanzw.com",
    "url": "https://harlanzw.com/"
  },
  "contributors": [
    {
      "name": "André Cruz",
      "url": "https://github.com/edevil"
    },
    {
      "name": "Bernardo Pereira",
      "url": "https://github.com/BernardoPe"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/harlan-zw/mdream",
    "directory": "packages/mdream"
  },
  "sideEffects": [
    "./wasm-bundler/mdream_edge.js"
  ],
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/edge.d.mts",
        "default": "./dist/edge.mjs"
      },
      "edge-light": {
        "types": "./dist/edge.d.mts",
        "default": "./dist/edge.mjs"
      },
      "types": "./dist/index.d.mts",
      "browser": "./dist/browser-stub.mjs",
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "default": "./dist/browser.mjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.mts",
      "default": "./dist/wasm.mjs"
    },
    "./wasm/*": "./wasm/*"
  },
  "main": "./dist/index.mjs",
  "unpkg": "./dist/iife.js",
  "jsdelivr": "./dist/iife.js",
  "types": "./dist/index.d.mts",
  "bin": {
    "mdream": "./bin/mdream.mjs"
  },
  "files": [
    "bin",
    "dist",
    "napi/",
    "skills",
    "wasm-bundler/",
    "wasm/"
  ],
  "scripts": {
    "ts": "node  --experimental-strip-types",
    "test:live": "curl -s https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax | node ./bin/mdream.mjs --origin https://docs.github.com | tee test/github-markdown.md",
    "test:images": "cat test/fixtures/test-origin.html | node ./bin/mdream.mjs --origin https://docs.github.com",
    "test:github:live": "curl -s https://docs.github.com/en/get-started/writing-on-github/getting-started-with-writing-and-formatting-on-github/basic-writing-and-formatting-syntax | node ./bin/mdream.mjs --origin https://docs.github.com | tee test/github-markdown.md",
    "test:github:file": "cat test/fixtures/github-markdown-complete.html | node ./bin/mdream.mjs --origin https://docs.github.com | tee test/github-markdown.md",
    "test:wiki:file": "pnpm build && cat test/fixtures/wikipedia-largest.html | node ./bin/mdream.mjs --origin https://en.wikipedia.org | tee test/wiki-markdown.md",
    "test:wiki-small:file": "cat test/fixtures/wikipedia-small.html | node ./bin/mdream.mjs --origin https://en.wikipedia.org | tee test/wiki-markdown.md",
    "build": "obuild",
    "build:native": "pnpm --dir ../../crates/node run build:platform",
    "build:edge": "node ../../scripts/build-wasm-edge.mjs --target web --out-dir ../../packages/mdream/wasm --out-name mdream_edge && node ../../scripts/build-wasm-edge.mjs --target bundler --out-dir ../../packages/mdream/wasm-bundler --out-name mdream_edge",
    "typecheck": "tsc --noEmit",
    "dev:prepare": "obuild --stub",
    "test": "vitest test",
    "test:attw": "attw --pack",
    "prepack": "pnpm run build"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@mdream/rust-android-arm-eabi": "workspace:*",
    "@mdream/rust-android-arm64": "workspace:*",
    "@mdream/rust-darwin-arm64": "workspace:*",
    "@mdream/rust-darwin-x64": "workspace:*",
    "@mdream/rust-freebsd-x64": "workspace:*",
    "@mdream/rust-linux-arm-gnueabihf": "workspace:*",
    "@mdream/rust-linux-arm64-gnu": "workspace:*",
    "@mdream/rust-linux-arm64-musl": "workspace:*",
    "@mdream/rust-linux-x64-gnu": "workspace:*",
    "@mdream/rust-linux-x64-musl": "workspace:*",
    "@mdream/rust-wasm32-wasi": "workspace:*",
    "@mdream/rust-win32-arm64-msvc": "workspace:*",
    "@mdream/rust-win32-x64-msvc": "workspace:*"
  },
  "devDependencies": {
    "@mdream/js": "workspace:*",
    "@mdream/rust-build": "workspace:*",
    "rolldown": "catalog:"
  }
}
